<% const posts = bento_posts(); const recent = posts.slice(0, 3); const topics = bento_topics(); const latestDate = posts.length ? date(posts[0].date, 'YYYY.MM.DD') : ''; %>
<section class="bento-grid" aria-label="我的数字小角落">
  <article class="bento-card intro-card">
    <div class="card-eyebrow"><span class="status-dot"></span>A LITTLE SPACE ON THE INTERNET</div>
    <div class="intro-heading"><h1>你好，我是 <span>lipu.</span></h1><span class="intro-spark" aria-hidden="true">✳</span></div>
    <p class="intro-statement">在代码与芯片之间，<br>记录一些值得留下的东西。</p>
    <p class="intro-description">关于网络、硬件和 AI 的学习笔记。<br class="desktop-break">也留一点空间，给思考和好奇心。</p>
    <a class="text-link" href="<%= url_for('/about/') %>">认识我一下 <span aria-hidden="true">↗</span></a>
    <span class="intro-coordinate" aria-hidden="true">HELLO, WORLD_</span>
  </article>
  <article class="bento-card fabric-card"><%- partial('_partial/fabric') %></article>
  <a class="bento-card topic-card ai-card" href="<%= url_for('/archives/') %>?topic=ai">
    <span class="card-eyebrow">READ · THINK · REPEAT</span>
    <div class="paper-art" aria-hidden="true"><span class="paper-back"></span><span class="paper-front"><i></i><i></i><i></i><svg viewBox="0 0 100 44" fill="none"><path d="M2 34C16 34 16 10 30 10S44 34 58 34s14-24 28-24 14 18 14 18"/></svg></span><span class="paper-star">✦</span></div>
    <div class="topic-card-bottom"><div><h2>论文与模型</h2><p>从 Attention 到 AI Infra</p></div><span class="round-arrow" aria-hidden="true">↗</span></div>
  </a>
  <a class="bento-card topic-card hardware-card" href="<%= url_for('/archives/') %>?topic=hardware">
    <span class="card-eyebrow">CLOSER TO THE METAL</span>
    <div class="chip-art" aria-hidden="true"><span class="chip-pins pin-top"></span><span class="chip-pins pin-bottom"></span><span class="chip-pins pin-left"></span><span class="chip-pins pin-right"></span><div class="chip-core"><span>0101</span><strong>FPGA</strong><span>1100</span></div></div>
    <div class="topic-card-bottom"><div><h2>走近硬件</h2><p>电路、架构与底层逻辑</p></div><span class="round-arrow" aria-hidden="true">↗</span></div>
  </a>
  <article class="bento-card notebook-card">
    <div class="card-topline"><span class="card-eyebrow">THE NOTEBOOK</span><span class="mini-label"><%= posts.length %> 篇记录</span></div>
    <h2>好奇心，有迹可循。</h2>
    <p>把遇到的问题写下来，<br>把想明白的事情留下来。</p>
    <div class="notebook-topics"><% topics.forEach(function(topic){ %><a href="<%= url_for('/archives/') %>?topic=<%= topic.key %>"><span class="topic-dot topic-<%= topic.key %>"></span><%= topic.label %><span><%= topic.count %></span></a><% }); %></div>
    <a class="text-link" href="<%= url_for('/archives/') %>">翻开所有笔记 <span aria-hidden="true">→</span></a>
  </article>
  <a class="bento-card github-card" href="https://github.com/lipu0324" target="_blank" rel="noopener noreferrer">
    <div class="card-topline"><span class="card-eyebrow">BUILD IN THE OPEN</span><span class="external-arrow" aria-hidden="true">↗</span></div>
    <div class="github-art" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.06c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.71 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.15-2.97-.12-.28-.5-1.41.11-2.94 0 0 .94-.3 3.06 1.14A10.7 10.7 0 0 1 12 6.28c.95 0 1.9.13 2.79.37 2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.72.77 1.15 1.76 1.15 2.97 0 4.26-2.6 5.21-5.08 5.49.4.34.76 1.02.76 2.06V22c0 .3.2.64.76.53A11.1 11.1 0 0 0 12 .9Z"/></svg><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span></div>
    <h2>想法，<br>也可以运行。</h2><p>github.com/lipu0324</p>
  </a>
  <article class="bento-card now-card">
    <div class="card-eyebrow">A WORK IN PROGRESS</div>
    <div class="now-graphic" aria-hidden="true"><span>{</span><i>↗</i><span>}</span></div>
    <h2>保持好奇。<br>继续折腾。</h2>
    <p>记录学习的过程，<br>也记录还没想明白的问题。</p>
    <% if(latestDate){ %><div class="last-updated"><span class="status-dot"></span>最近落笔 <%= latestDate %></div><% } %>
  </article>
</section>
<section class="latest-section" aria-labelledby="latest-heading">
  <div class="section-heading"><div><span class="card-eyebrow">FRESH FROM THE NOTEBOOK</span><h2 id="latest-heading">最近写下的</h2></div><a class="text-link" href="<%= url_for('/archives/') %>">全部文章 <span aria-hidden="true">↗</span></a></div>
  <div class="recent-grid"><% recent.forEach(function(post,index){ const topic=bento_topic(post); %>
    <a class="recent-card" href="<%= url_for(post.path) %>">
      <div class="recent-meta"><span class="topic-label topic-<%= topic.key %>"><span class="topic-dot"></span><%= topic.label %></span><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM.DD') %></time></div>
      <h3><%= post.title %></h3><p><%= bento_text(post, 88) %></p>
      <div class="recent-bottom"><span><%= bento_minutes(post) %> 分钟阅读</span><span class="round-arrow" aria-hidden="true">↗</span></div>
    </a>
  <% }); %></div>
</section>
