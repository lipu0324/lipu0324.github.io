<div class="fabric" data-fabric data-active="01" data-running="true">
  <div class="fabric-heading">
    <div>
      <p class="fabric-eyebrow">PACKET PLAYGROUND</p>
      <h2>让数据流动起来<span aria-hidden="true">.</span></h2>
    </div>
    <button class="fabric-motion" type="button" data-fabric-motion aria-label="暂停数据流动画" aria-pressed="false" title="暂停动画">
      <svg class="fabric-pause-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5.5 4v8M10.5 4v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="fabric-play-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 4 6 4-6 4V4Z" fill="currentColor"/></svg>
    </button>
  </div>

  <svg class="fabric-scene" data-fabric-scene viewBox="0 0 520 324" xmlns="http://www.w3.org/2000/svg" aria-labelledby="fabric-title fabric-description">
    <title id="fabric-title">计算节点与网络互连</title>
    <desc id="fabric-description">四个计算节点围绕中心互连芯片。选择节点可高亮它的数据路径；动画仅为视觉演示。</desc>
    <defs>
      <pattern id="fabric-grid" width="44" height="24" patternUnits="userSpaceOnUse"><path d="m0 12 22-12 22 12-22 12Z" fill="none" stroke="currentColor" stroke-width=".65"/></pattern>
      <radialGradient id="fabric-halo"><stop offset="0" stop-color="#c2c7ed" stop-opacity=".45"/><stop offset="1" stop-color="#c2c7ed" stop-opacity="0"/></radialGradient>
      <filter id="fabric-shadow" x="-40%" y="-60%" width="180%" height="240%"><feGaussianBlur stdDeviation="7"/></filter>
      <g id="fabric-compute-tile">
        <ellipse class="fabric-node-shadow" cx="0" cy="22" rx="41" ry="15"/>
        <path class="fabric-node-ring" d="M0-33 59-1 0 31-59-1Z" fill="none" stroke-width="1.5"/>
        <g class="fabric-node-lift">
          <path class="fabric-node-left" d="m-44 0 44 24v12l-44-24Z"/>
          <path class="fabric-node-right" d="m44 0-44 24v12l44-24Z"/>
          <path class="fabric-node-top" d="M0-24 44 0 0 24-44 0Z"/>
          <path class="fabric-node-chip" d="M0-14 26 0 0 14-26 0Z"/>
          <g class="fabric-node-traces" fill="none" stroke-width="1">
            <path d="m-14-14 28 15M-23-9 28 15M-5-19 28 15M-23 9 28-15M-14 14 28-15M-5 19 28-15"/>
          </g>
          <path class="fabric-node-pin" d="m-35 12 5 2.7m4 2.3 5 2.7m4 2.3 5 2.7" fill="none" stroke-width="2.5" stroke-linecap="round"/>
          <circle class="fabric-node-led" cx="27" cy="16" r="2"/>
        </g>
      </g>
      <path id="fabric-route-01" d="M112 99 174 133Q181 137 188 141L218 157"/>
      <path id="fabric-route-02" d="M408 99 346 133Q339 137 332 141L302 157"/>
      <path id="fabric-route-03" d="M112 248 174 214Q181 210 188 206L218 190"/>
      <path id="fabric-route-04" d="M408 248 346 214Q339 210 332 206L302 190"/>
    </defs>

    <ellipse cx="260" cy="172" rx="216" ry="133" fill="url(#fabric-halo)"/>
    <path class="fabric-floor" d="m260 32 236 129-236 129L24 161Z"/>
    <path class="fabric-floor-grid" d="m260 32 236 129-236 129L24 161Z" fill="url(#fabric-grid)"/>
    <path class="fabric-floor-outline" d="m260 32 236 129-236 129L24 161Z" fill="none"/>

    <g class="fabric-routes" fill="none">
      <% ['01', '02', '03', '04'].forEach(function(node) { %>
        <g class="fabric-route" data-fabric-route="<%= node %>">
          <use class="fabric-route-bed" href="#fabric-route-<%= node %>"/>
          <use class="fabric-route-line" href="#fabric-route-<%= node %>"/>
          <circle class="fabric-packet fabric-packet-halo" r="7">
            <animateMotion dur="3s" begin="-<%= Number(node) * .6 %>s" repeatCount="indefinite"><mpath href="#fabric-route-<%= node %>"/></animateMotion>
          </circle>
          <circle class="fabric-packet" r="3.2">
            <animateMotion dur="3s" begin="-<%= Number(node) * .6 %>s" repeatCount="indefinite"><mpath href="#fabric-route-<%= node %>"/></animateMotion>
          </circle>
          <circle class="fabric-packet fabric-packet-secondary" r="2">
            <animateMotion dur="3s" begin="-<%= Number(node) * .6 + 1.5 %>s" repeatCount="indefinite"><mpath href="#fabric-route-<%= node %>"/></animateMotion>
          </circle>
        </g>
      <% }); %>
    </g>

    <g class="fabric-hub">
      <ellipse class="fabric-hub-shadow" cx="260" cy="196" rx="83" ry="25" filter="url(#fabric-shadow)"/>
      <path class="fabric-base-left" d="m180 166 80 43v13l-80-43Z"/>
      <path class="fabric-base-right" d="m340 166-80 43v13l80-43Z"/>
      <path class="fabric-base-top" d="m260 122 80 44-80 43-80-43Z"/>
      <path class="fabric-board-line" d="m260 130 65 36-65 35-65-35Z" fill="none"/>
      <g class="fabric-pins" fill="none" stroke-width="3" stroke-linecap="round">
        <path d="m199 157 9 5m0-10 9 5m0-10 9 5m0-10 9 5m0-10 9 5m0-10 9 5M312 162l9-5m-18 0 9-5m-18 0 9-5m-18 0 9-5m-18 0 9-5m-18 0 9-5M199 175l9-5m0 10 9-5m0 10 9-5m0 10 9-5m0 10 9-5m0 10 9-5m59-20 9 5m-18 0 9 5m-18 0 9 5m-18 0 9 5m-18 0 9 5m-18 0 9 5"/>
      </g>
      <path class="fabric-chip-left" d="m204 150 56 30v12l-56-30Z"/>
      <path class="fabric-chip-right" d="m316 150-56 30v12l56-30Z"/>
      <path class="fabric-chip-top" d="m260 120 56 30-56 30-56-30Z"/>
      <path class="fabric-chip-detail" d="m260 128 41 22-41 22-41-22Z" fill="none"/>
      <text class="fabric-chip-label" x="260" y="153" text-anchor="middle">FABRIC</text>
      <circle class="fabric-chip-dot" cx="260" cy="165" r="2"/>
    </g>

    <% [
      { id: '01', x: 112, y: 82, color: 'mint' },
      { id: '02', x: 408, y: 82, color: 'lavender' },
      { id: '03', x: 112, y: 242, color: 'blue' },
      { id: '04', x: 408, y: 242, color: 'peach' }
    ].forEach(function(node) { %>
      <g class="fabric-node fabric-node--<%= node.color %>" data-fabric-node="<%= node.id %>" transform="translate(<%= node.x %> <%= node.y %>)" role="button" tabindex="0" aria-label="高亮计算节点 <%= node.id %> 的数据路径" aria-pressed="<%= node.id === '01' ? 'true' : 'false' %>">
        <title>选择计算节点 <%= node.id %></title>
        <use href="#fabric-compute-tile"/>
        <text class="fabric-node-label" x="0" y="57" text-anchor="middle">NODE <%= node.id %></text>
      </g>
    <% }); %>
  </svg>

  <div class="fabric-caption">
    <span class="fabric-live"><span class="fabric-live-dot" aria-hidden="true"></span><span data-fabric-status>NODE 01 → FABRIC</span></span>
    <span class="fabric-hint">点击节点，探索连接 <span aria-hidden="true">↗</span></span>
  </div>
</div>
