<div id="lipu-term" class="term">
  <div class="term-titlebar">
    <span class="term-dots"><i class="d-r"></i><i class="d-y"></i><i class="d-g"></i></span>
    <span class="term-title">guest@lipu0324: ~</span>
    <span class="term-links">
      <a href="<%- url_for('/archives/') %>">archives</a>
      <a href="<%- url_for('/about/') %>">about</a>
      <a href="https://github.com/lipu0324">github</a>
    </span>
  </div>
  <div class="term-screen" id="term-screen">
    <div class="term-output" id="term-output"></div>
    <div class="term-inputline" id="term-inputline"><span class="term-prompt" id="term-prompt"></span><span class="term-cmdwrap"><span id="term-before"></span><span class="term-cursor" id="term-cursor">&nbsp;</span><span id="term-after"></span></span></div>
  </div>
  <input id="term-input" class="term-hidden-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="terminal input" />
</div>

<noscript>
  <div class="term-noscript">
    <p>终端需要启用 JavaScript。你也可以直接浏览全部文章：</p>
    <ul>
      <% site.posts.sort('date', 'desc').each(function(post) { %>
        <li><a href="<%- url_for(post.path) %>"><%= post.title || 'Untitled' %></a> · <%= date(post.date, config.date_format) %></li>
      <% }); %>
    </ul>
  </div>
</noscript>

<script>
  window.__LIPU_TERM__ = { fs: '<%- url_for('/fs.json') %>' };
</script>
<%- js('js/terminal') %>
