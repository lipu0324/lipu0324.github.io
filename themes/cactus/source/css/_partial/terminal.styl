// -----------------------------------------------------------
// lipuOS terminal (homepage, fullscreen, oh-my-zsh robbyrussell)
// -----------------------------------------------------------

$term-bg = #0d1117
$term-fg = #c9d1d9
$term-dim = #8b949e
$term-green = #2ecf5f
$term-cyan = #39c5cf
$term-blue = #58a6ff
$term-red = #f85149
$term-hl = #ff7b72

// full-bleed terminal: no paper background, no page footer on home
body.is-home
  max-width: none
  padding: 0
  background: $term-bg
  background-image: none

  .content
    padding: 0

  #footer
    display: none

.term
  min-height: 100vh
  background: $term-bg
  color: $term-fg
  font-family: $font-family-mono

.term-screen
  position: relative
  padding: 22px 26px 48px
  min-height: 100vh
  font-size: 14px
  line-height: 1.65

  &:before
    content: ""
    position: absolute
    top: 0
    right: 0
    bottom: 0
    left: 0
    background: repeating-linear-gradient(0deg, rgba(255, 255, 255, .014) 0 1px, transparent 1px 3px)
    pointer-events: none

  ::selection
    background: rgba(88, 166, 255, .32)
    color: #fff

  // neutralize the site's red paper link style inside the terminal
  a
    background: none
    color: inherit
    text-shadow: none

    &:hover
      background: none
      color: $term-blue
      text-shadow: none

.t-line
  white-space: pre-wrap
  word-break: break-word

  a
    border-bottom: 1px dotted $term-dim

    &:hover
      border-bottom-color: $term-blue

// oh-my-zsh (robbyrussell) prompt: ➜  ~/posts git:(main)
.term-inputline
.term-prompt
  white-space: pre-wrap
  word-break: break-word

.p-arrow
  color: $term-green
  font-weight: 700

  &.fail
    color: $term-red

.p-path
  color: $term-cyan
  font-weight: 700

.p-git
  color: $term-dim

.p-branch
  color: $term-red

.term-cursor
  background: $term-fg
  color: $term-bg

  &.idle
    animation: term-blink 1.06s step-end infinite

@keyframes term-blink
  0%, 100%
    opacity: 1
  50%
    opacity: 0

.t-err
  color: $term-red

.t-dim
  color: $term-dim

.t-dir
  color: $term-blue
  font-weight: 600

.t-path
  color: $term-green

.t-ln
  color: $term-dim

.t-hl
  color: $term-hl
  font-weight: 700

.t-neo-art
  color: $term-red

.t-neo-k
  color: $term-cyan
  font-weight: 600

.term-hidden-input
  position: fixed
  bottom: 0
  left: 0
  width: 2px
  height: 2px
  padding: 0
  opacity: 0
  border: none
  outline: none

.term-noscript
  padding: 22px 26px
  color: $term-fg
  font-size: 14px

  a
    color: $term-blue

@media (max-width: 640px)
  .term-screen
    padding: 14px 14px 32px
    font-size: 12.5px
